# =============================================================================
# Konfiguracja RP. Skopiuj ten plik jako ".env" i uzupełnij wartości.
#
#   cp .env.example .env
#
# Minimum do zmiany: JWT_SECRET, ADMIN_PASSWORD.
# =============================================================================

# Sekret do podpisywania tokenów JWT. Wygeneruj losowy:
#   Linux/Mac: openssl rand -hex 32
#   Windows:   w PowerShell: -join ((1..64) | %{'{0:x}' -f (Get-Random -Max 16)})
JWT_SECRET=change-me-generate-your-own-random-string-min-32-chars

# Konto administratora — seedowane przy PIERWSZYM starcie na pustej bazie.
# Po pierwszym uruchomieniu env jest ignorowane (admin już istnieje).
# Hasło można potem zmienić w panelu #/admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmien-to-haslo-po-pierwszym-starcie

# Port hosta (opcjonalnie) — jeśli chcesz inny niż 8787.
# Pamiętaj żeby zmienić też mapowanie portów w docker-compose.yml.
# PORT=8787

# Dozwolone cele proxy modeli, wyszukiwania i obrazów (hosty bez protokołu/ścieżki).
# Puste: tylko prywatne adresy LAN. Niepuste: WYŁĄCZNIE hosty z tej listy,
# więc dodaj także adresy swoich lokalnych usług, jeśli nadal ich używasz.
PROXY_ALLOWED_HOSTS=
# Przykład: OpenRouter + model lokalny + mostek obrazów (zmień IP na własne).
# PROXY_ALLOWED_HOSTS=openrouter.ai,192.168.100.80,192.168.100.81:8040

# Opcjonalne timeouty proxy w milisekundach.
# PROXY_TIMEOUT_GET_MS=60000
# PROXY_TIMEOUT_POST_MS=600000

# Minimalny wiek blobów przed sprzątaniem, w milisekundach.
# GC_MIN_BLOB_AGE_MS=3600000
